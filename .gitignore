# =============================================================================
# Alpha AI – .gitignore
# =============================================================================

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtuelle Umgebungen
.venv/
venv/
env/

# Test- und Werkzeug-Caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Laufzeit-Artefakte (Ordner bleiben via .gitkeep erhalten, Inhalte nicht)
logs/*
!logs/.gitkeep
output/*
!output/.gitkeep

# Datenbankdateien
*.sqlite
*.sqlite3
*.db

# Editor / OS
.idea/
.vscode/
.DS_Store
